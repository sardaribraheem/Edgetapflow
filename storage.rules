rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.uid in firestore.get(/databases/(default)/documents/config/admin_uids).data.uids;
    }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function image(max) {
      return request.resource.size > 0 && request.resource.size <= max
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /avatars/{uid}/{filename} {
      allow get: if true;
      allow create: if owner(uid) && image(5 * 1024 * 1024);
      allow update: if owner(uid) && image(5 * 1024 * 1024);
      allow delete: if owner(uid) || isAdmin();
    }
    match /avatarInbox/{token}/{filename} {
      allow get: if true;
      allow write: if false;
    }
    match /orderInbox/{uid}/{filename} {
      allow create: if owner(uid) && image(25 * 1024 * 1024);
      allow get: if owner(uid) || isAdmin();
      allow update: if false;
      allow delete: if owner(uid) || isAdmin();
    }
    match /paymentReceipts/{uid}/{filename} {
      allow create: if owner(uid) && image(8 * 1024 * 1024);
      allow get: if owner(uid) || isAdmin();
      allow update: if false;
      allow delete: if owner(uid) || isAdmin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
