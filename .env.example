# Public Firebase web configuration only; never add service-account credentials here.
NEXT_PUBLIC_FIREBASE_API_KEY=your_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_web_app_id
NEXT_PUBLIC_APP_URL=https://edgetapflow.web.app
# Existing installation targets (default), which currently requires billing.
# The project's free-tier database is named default; prepare its rules/data first.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)
# Enable only after real Auth, receipt upload and order persistence are verified.
NEXT_PUBLIC_ONLINE_CHECKOUT_ENABLED=false

# Explicit backend selection; defaults to Firebase for existing installations.
# Select supabase only after schema, identities, assets and real access are verified.
NEXT_PUBLIC_DATA_BACKEND=firebase
NEXT_PUBLIC_SUPABASE_URL=
# Public publishable key only (sb_publishable_...). Never use sb_secret_/service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
