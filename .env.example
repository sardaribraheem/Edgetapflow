# Production data starts clean in Supabase. No Firebase test records are imported.
NEXT_PUBLIC_DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=https://dxyxvervvlxhwwbcbttd.supabase.co
# Public publishable key only. Never use sb_secret_ or service_role in NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=https://edgetapflow.web.app
# Keep false until hosted Auth/Storage/orders and manual-payment checks pass.
NEXT_PUBLIC_ONLINE_CHECKOUT_ENABLED=false

# Legacy Firebase configuration retained for explicitly selected development only.
# Set NEXT_PUBLIC_DATA_BACKEND=firebase to use these; there is no automatic fallback.
NEXT_PUBLIC_FIREBASE_API_KEY=your_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_web_app_id
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)
