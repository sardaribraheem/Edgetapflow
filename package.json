{
  "name": "edgetap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
