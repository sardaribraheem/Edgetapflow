{
  "name": "edgetap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:profile-account-admin": "node scripts/test-profile-account-admin.mjs",
    "test:profile-account-admin:browser": "node scripts/test-profile-account-admin-browser.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/test-site.mjs",
    "test:ux": "node scripts/test-ux-browser.mjs",
    "serve:qa": "node scripts/serve-export.mjs",
    "check:release": "node scripts/check-hosting-release.mjs",
    "deploy:hosting": "npm run build && npm run check:release && npx --yes firebase-tools@15.33.0 deploy --only hosting --project edgetapflow --non-interactive",
    "test:rules": "firebase emulators:exec --config firebase.qa.json --project demo-edgetap-qa --only firestore,storage,auth \"node scripts/test-rules.mjs && node scripts/test-services.mjs\"",
    "test:supabase": "node scripts/test-supabase-config.mjs && node scripts/test-supabase.mjs && node scripts/test-applications.mjs && node scripts/test-business-migration.mjs && node scripts/test-ordering-upgrade.mjs && node scripts/test-profile-editing.mjs && node scripts/test-physical-cards.mjs && node scripts/test-card-products.mjs && node scripts/test-nfc-link.mjs && node scripts/test-card-editor.mjs && node scripts/test-card-branding.mjs && node scripts/test-design-proof-review.mjs && node scripts/test-domain-migration.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "test:supabase:browser": "node scripts/test-supabase-browser.mjs",
    "check:supabase:hosted": "node scripts/check-hosted-supabase.mjs",
    "test:supabase:hosted-browser": "node scripts/test-hosted-supabase-browser.mjs",
    "test:card-products": "node scripts/test-card-products.mjs && node scripts/test-nfc-link.mjs",
    "test:card-products:browser": "node scripts/test-card-products-browser.mjs",
    "test:card-editor": "node scripts/test-card-editor.mjs",
    "test:card-editor:browser": "node scripts/test-card-editor-browser.mjs",
    "test:card-gallery": "node scripts/test-card-branding.mjs",
    "test:card-gallery:browser": "node scripts/test-card-gallery-browser.mjs",
    "test:design-review": "node scripts/test-design-proof-review.mjs",
    "test:design-review:browser": "node scripts/test-design-proof-review-browser.mjs",
    "test:seo": "node scripts/test-seo.mjs && node scripts/test-domain-migration.mjs",
    "test:seo:browser": "node scripts/test-seo-browser.mjs",
    "test:uiux": "node scripts/test-checkout-improvements.mjs && node scripts/test-order-notification-worker.mjs && node scripts/test-test-order-cleanup.mjs",
    "test:uiux:browser": "node scripts/test-uiux-browser.mjs",
    "test:story:browser": "node scripts/test-story-browser.mjs",
    "build:card-previews": "node scripts/build-card-previews.mjs",
    "test:website-offers": "node scripts/test-website-offers.mjs",
    "test:website-feedback:browser": "node scripts/test-website-feedback-browser.mjs",
    "test:image-uploads": "node scripts/test-image-uploads.mjs",
    "test:website-reviews": "node scripts/test-website-reviews.mjs",
    "test:free-profiles": "node scripts/test-free-profiles-staff.mjs",
    "test:free-profiles:browser": "node scripts/test-free-profiles-staff-browser.mjs",
    "test:admin-pricing": "node scripts/test-admin-pricing-profiles.mjs",
    "test:admin-pricing:browser": "node scripts/test-admin-pricing-profiles-browser.mjs",
    "test:admin-backups": "node scripts/test-admin-backups.mjs && node scripts/test-backup-format.mjs",
    "test:admin-workspace:browser": "node scripts/test-admin-workspace-browser.mjs",
    "test:product-milestones": "node scripts/test-product-catalog.mjs && node scripts/test-profile-plans.mjs && node scripts/test-profile-sections.mjs && node scripts/test-image-uploads.mjs && node scripts/test-catalog-loading.mjs",
    "test:product-milestones:browser": "node scripts/test-product-milestones-browser.mjs",
    "test:profile-showcases": "node scripts/test-profile-showcases.mjs",
    "test:profile-showcases:browser": "node scripts/test-profile-showcases-browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
